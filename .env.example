# Copy to .env.production and fill in real values:
#   cp .env.example .env.production
#
# Start Compose with:
#   docker compose --env-file .env.production up --build
#
# IMPORTANT: POSTGRES_PASSWORD is embedded in DATABASE_URI.
# Use a URI-safe password (letters, numbers, - _). Avoid @ : / # ? &.

POSTGRES_PASSWORD=change-me-uri-safe-password

SECRET_KEY=change-me-long-random-string
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

TURNSTILE_SITE_KEY=change-me
TURNSTILE_SECRET_KEY=change-me

# Optional
WEB_CONCURRENCY=2
# RATELIMIT_STORAGE_URI=memory://
